# Copy this file to .env.local for local development.
# Never commit .env.local or put real keys into the code.

# --- Database -----------------------------------------------------------------
# Local development: the embedded PostgreSQL started by `npm run dev`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/pixelwall
# Production (Supabase): Project Settings → Database → Connection string →
# "Transaction pooler" (port 6543), with your database password filled in.
# DATABASE_URL=postgres://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Site -----------------------------------------------------------------------
# Public base URL without a trailing slash (used in share links and e-mails).
SITE_URL=http://localhost:3000
# "development" locally, "production" on the live site (blocks test data).
APP_ENV=development

# --- File storage ---------------------------------------------------------------
# "local" stores files in .data/storage (development only).
# "supabase" uses Supabase Storage (buckets "wall" = public, "content" = private).
STORAGE_DRIVER=local
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   (Project Settings → API keys → secret / service_role key; server only!)

# --- Internal jobs --------------------------------------------------------------
# Random secret for cron jobs and internal endpoints (any long random string).
CRON_SECRET=change-me-to-a-long-random-string

# --- Payments --------------------------------------------------------------------
# "dev" shows a test payment page on this site (never in production).
# "stripe" will be used once the Stripe account is connected.
PAYMENT_PROVIDER=dev

# --- E-mails ---------------------------------------------------------------------
# "log" keeps e-mails in the database (readable at /dev/emails during development).
# "resend" sends them with Resend (needs RESEND_API_KEY and EMAIL_FROM).
EMAIL_DRIVER=log
# RESEND_API_KEY=
# EMAIL_FROM="Million Pixel Wall <hello@your-domain.com>"

# --- Accounts and administration ----------------------------------------------
# Random secret (at least 32 characters) that encrypts the two-factor keys of
# staff accounts. Never change it later: existing two-factor setups would stop working.
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# These addresses become administrators when they sign in (the first admin of a
# new site). More moderators/admins can be added later in Admin → Tools.
ADMIN_EMAILS=you@example.com

# --- Bot protection (Cloudflare Turnstile, free) --------------------------------
# Without keys the check is skipped (fine for local development).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Automatic checks before moderation (optional) ------------------------------
# Links: "webrisk" (Google Web Risk, for commercial sites) or "safebrowsing".
# LINK_CHECK_PROVIDER=webrisk
# GOOGLE_WEB_RISK_API_KEY=
# GOOGLE_SAFE_BROWSING_API_KEY=
# Pictures: "sightengine" or "google" (Cloud Vision SafeSearch).
# IMAGE_MODERATION_PROVIDER=sightengine
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
# GOOGLE_VISION_API_KEY=

# --- Visit statistics without cookies (optional) ----------------------------------
# "plausible" (ANALYTICS_SITE_ID = your domain) or "umami" (ANALYTICS_SITE_ID = website id).
# ANALYTICS_PROVIDER=plausible
# ANALYTICS_SITE_ID=
# ANALYTICS_SCRIPT_URL=   (only for a self-hosted server)
