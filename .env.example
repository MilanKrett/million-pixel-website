# Copy this file to .env.local for local development.
# Never commit .env.local or put real keys into the code.

# --- Database -----------------------------------------------------------------
# Local development: the embedded PostgreSQL started by `npm run dev`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/pixelwall
# Production (Supabase): Project Settings → Database → Connection string →
# "Transaction pooler" (port 6543), with your database password filled in.
# DATABASE_URL=postgres://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Site -----------------------------------------------------------------------
# Public base URL without a trailing slash (used in share links and e-mails).
SITE_URL=http://localhost:3000
# "development" locally, "production" on the live site (blocks test data).
APP_ENV=development

# --- File storage ---------------------------------------------------------------
# "local" stores files in .data/storage (development only).
# "supabase" uses Supabase Storage (buckets "wall" = public, "content" = private).
STORAGE_DRIVER=local
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   (Project Settings → API keys → secret / service_role key; server only!)

# --- Internal jobs --------------------------------------------------------------
# Random secret for cron jobs and internal endpoints (any long random string).
CRON_SECRET=change-me-to-a-long-random-string
